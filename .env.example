# Copie para `.env` e ajuste se precisar. O `.env` não vai para o git.

# Banco do docker-compose.yml
DATABASE_URL="postgresql://smartposte:smartposte@localhost:5433/smartposte"

# 0.0.0.0 permite que o celular na mesma rede Wi-Fi acesse a API
HOST=0.0.0.0
PORT=3333

# Assina os tokens de login. Mínimo de 32 caracteres; nunca versionar o valor real.
# Gere um com: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET="troque-por-um-valor-aleatorio-com-32-caracteres-ou-mais"

# Cloudinary (fotos das denúncias): Settings → API Keys. Use uma chave própria, não a Root.
# O API Secret é uma senha: só no .env, nunca no git.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Atrás de um proxy (Render): IP/CIDR do proxy confiável para o IP real (ex.: 10.0.0.0/8). Local: vazio.
TRUST_PROXY=""

# Só em produção (Neon): DATABASE_URL é a URL com pool ("-pooler") usada pela API, e
# DIRECT_URL a conexão direta usada pelas migrations. Localmente, deixe DIRECT_URL de fora.
# DIRECT_URL=""
